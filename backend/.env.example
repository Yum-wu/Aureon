# === Core ===
# API authentication key (leave empty to disable auth in dev)
# API_AUTH_KEY=

# Environment: "dev" or "production"
# ENVIRONMENT=production

# === LLM ===
# LLM_API_KEY=
# LLM_MODEL=qwen3.5-flash
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# FALLBACK_API_KEY=
# FALLBACK_MODEL=GLM-4-Flash-250414
# FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=chatbot-rag
# LLM_SEMAPHORE_QWEN=30
# LLM_SEMAPHORE_REASONER=10
# LLM_SEMAPHORE_DEFAULT=20

# === Embedding ===
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# EMBEDDING_MODEL=embedding-2
# EMBEDDING_DIM=1024
# EMBEDDING_BATCH_SIZE=64
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# DASHSCOPE_MODEL=text-embedding-v4
# DASHSCOPE_DIMENSIONS=1024
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=BAAI/bge-large-zh-v1.5
# EMBEDDING__OPENROUTER_API_KEY=
# EMBEDDING__OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING__OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# SPARSE_ENABLED=true
# SPARSE_PROVIDER=siliconflow
# SPARSE_MODEL=BAAI/bge-m3

# === Vector Store (Qdrant) ===
# VECTOR_BACKEND=qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=aureon
# RRF_K=60
# RETRIEVAL_MULTIPLIER=12
# MULTI_QUERY_ENABLED=true
# SEMANTIC_CHUNKING_ENABLED=true
# MIN_RELEVANCE_SCORE=0.003
# VECTOR_MIN_COSINE=0.001
# VECTOR_MAX_CONTRIB=15
# VECTOR_CONFIDENCE_THRESHOLD=0.01
# LOW_SCORE_THRESHOLD=0.004
# NEGATIVE_DETECTION_ENABLED=true
# CONTEXT_COMPRESSION_ENABLED=true
# CONTEXT_COMPRESSION_THRESHOLD=0.30
# KW_MIN_RAW_SCORE=0.15
# STATS_CACHE_TTL=60.0
# HYDE_ENABLED=true
# HYDE_FALLBACK_THRESHOLD=0.01
# HIGH_SCORE_SKIP_THRESHOLD=0.1
# CLASSIFIER_CACHE_TTL=3600.0
# HNSW_M=32
# HNSW_EF_CONSTRUCT=200
# HNSW_EF_SEARCH=128
# QUERY_ROUTING_ENABLED=true
# QUANTIZATION_ENABLED=true
# VECTORS_ON_DISK=true

# === Rerank ===
# RERANK_ENABLED=true
# RERANK_BACKEND=api
# RERANK_PROVIDER=dashscope
# RERANK_CANDIDATES=20
# RERANKER_DEVICE=cpu
# ADAPTIVE_RERANK_ENABLED=true
# ADAPTIVE_RERANK_THRESHOLD=0.3
# ENSEMBLE_RERANK_ENABLED=false
# ENSEMBLE_BGE_WEIGHT=0.6
# ENSEMBLE_COHERE_WEIGHT=0.3
# ENSEMBLE_JINA_WEIGHT=0.1
# COHERE_API_KEY=
# COHERE_RERANK_MODEL=rerank-multilingual-v3.0
# JINA_API_KEY=
# DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/compatible-api/v1
# DASHSCOPE_RERANK_MODEL=qwen3-rerank
# RERANK__OPENROUTER_API_KEY=
# RERANK__OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# RERANK__OPENROUTER_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
# RERANK_SEMAPHORE=40

# === Cache (Redis) ===
# REDIS_URL=redis://localhost:6379
# SEMANTIC_CACHE_ENABLED=true
# SEMANTIC_CACHE_THRESHOLD=0.92
# SEMANTIC_CACHE_TTL=86400
# SEMANTIC_CACHE_MAX_SIZE=10000
# SEMANTIC_CACHE_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# === Database ===
# DATABASE_URL=
# ES_URL=http://localhost:9200
# ES_INDEX=aureon
# ES_PASSWORD=
# BM25_BACKEND=memory

# === App ===
# TAVILY_API_KEY=
# TENANT_ALLOWLIST=
# BLOG_URL=
# BLOG_SYNC_ENABLED=false
# BLOG_SYNC_API_KEY=
# CORS_ORIGINS=http://localhost:5173
# WEBSOCKET_ENABLED=true
# WEBSOCKET_MAX_CONNECTIONS=300
# WEBSOCKET_HEARTBEAT_INTERVAL=30
# WEBSOCKET_HEARTBEAT_TIMEOUT=300
# CONVERSATION_MAX_TURNS=20
# CONVERSATION_MAX_CONTEXT_TOKENS=4000
# TOOL_CALLING_ENABLED=true
# QUEUE_TIMEOUT_SECONDS=30.0
# LLM_SEMAPHORE_EMBEDDING=50
# RAG_SEMAPHORE=40
# CRAG_ENABLED=false
# CRAG_HIGH_CONFIDENCE=0.05
# CRAG_LOW_CONFIDENCE=0.01
# CRAG_AMBIGUOUS_THRESHOLD=0.03
# REFLECTION_ENABLED=false
# OFFLOAD_MAX_CHARS=1000
# SESSION_MAX_MESSAGES=500
# AUTO_INDEX_ENABLED=true
# BENCHMARK_MODE=local

# === Observability ===
# LANGSMITH_ENABLED=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=aureon-rag
# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_RELEASE=
# LANGFUSE_SESSION_ID=
