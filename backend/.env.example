LLM_API_KEY=your_deepseek_api_key_here
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
TAVILY_API_KEY=your_tavily_api_key_here

# Embedding fallback chain: local BGE → DashScope → SiliconFlow → Zhipu
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=text-embedding-v3
# DASHSCOPE_DIMENSIONS=1024

# EMBEDDING_API_KEY=your_zhipu_api_key_here
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# EMBEDDING_MODEL=embedding-2

# SILICONFLOW_API_KEY=your_siliconflow_api_key_here
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=BAAI/bge-small-zh-v1.5

# SKIP_LOCAL_EMBED=true  # Set to true when using API embedding only

# Redis (required for caching)
# REDIS_URL=redis://localhost:6379/0

# Vector store backend ("chroma" or "qdrant")
# VECTOR_BACKEND=chroma
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Elasticsearch BM25 backend
# ES_URL=http://localhost:9200
# ES_INDEX=aureon
# BM25_BACKEND=memory

# Blog sync configuration
# BLOG_URL=https://example.com/blog/
# BLOG_SYNC_ENABLED=false

# Authentication (required in production)
# API_AUTH_KEY=your_secure_api_key_here
