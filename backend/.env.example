# LLM: DashScope Qwen (same API key as DASHSCOPE_API_KEY)
LLM_API_KEY=your_dashscope_api_key_here
LLM_MODEL=qwen3.6-flash
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
TAVILY_API_KEY=your_tavily_api_key_here

# Embedding: DashScope text-embedding-v4 (768d, Singapore MaaS endpoint)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=text-embedding-v4
DASHSCOPE_DIMENSIONS=768

# Global embedding dimension (must match DASHSCOPE_DIMENSIONS when using DashScope)
EMBEDDING_DIM=768

# EMBEDDING_API_KEY=your_zhipu_api_key_here
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# EMBEDDING_MODEL=embedding-2

# SILICONFLOW_API_KEY=your_siliconflow_api_key_here
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=BAAI/bge-small-zh-v1.5

# Skip local BGE model — use DashScope API only (recommended for Railway)
SKIP_LOCAL_EMBED=true

# Redis (required for caching)
# REDIS_URL=redis://localhost:6379/0

# Vector store backend ("chroma" or "qdrant")
# For Railway: use Qdrant Cloud Free (https://qdrant.tech) — zero local memory
VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Elasticsearch BM25 backend
# ES_URL=http://localhost:9200
# ES_INDEX=aureon
# BM25_BACKEND=memory

# Semantic Cache Configuration
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL=86400
SEMANTIC_CACHE_MAX_SIZE=10000
SEMANTIC_CACHE_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# Blog sync configuration
# BLOG_URL=https://example.com/blog/
# BLOG_SYNC_ENABLED=false

# Adaptive Re-ranking Configuration
RERANK_ENABLED=true
RERANK_BACKEND=api
RERANK_PROVIDER=dashscope
ADAPTIVE_RERANK_ENABLED=true
ENSEMBLE_RERANK_ENABLED=false
RERANK_CANDIDATES=12
ADAPTIVE_RERANK_THRESHOLD=0.5

# DashScope Reranker (qwen3-rerank, same platform as embedding)
# Note: qwen3-rerank uses compatible-api (not compatible-mode) endpoint
DASHSCOPE_RERANK_URL=https://dashscope-intl.aliyuncs.com/compatible-api/v1

# Ensemble Reranker Weights
ENSEMBLE_BGE_WEIGHT=0.6
ENSEMBLE_COHERE_WEIGHT=0.3
ENSEMBLE_JINA_WEIGHT=0.1

# Cohere Reranker (optional)
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# Jina Reranker (optional)
JINA_API_KEY=

# Authentication (required in production)
# ENVIRONMENT=dev  # Set to "dev" for local development; defaults to "production"
# API_AUTH_KEY=your_secure_api_key_here
# JWT_SECRET=your_jwt_secret_here  # Required for SSO/RBAC
# ENCRYPTION_KEY=your_fernet_key_here  # Required for SSO secret encryption (production only)

# CORS (comma-separated origins; default: http://localhost:5173)
# CORS_ORIGINS=http://localhost:5173

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_MAX_CONNECTIONS=200
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_HEARTBEAT_TIMEOUT=60

# Conversation Configuration
CONVERSATION_MAX_TURNS=20
CONVERSATION_MAX_CONTEXT_TOKENS=4000

# ── Concurrency Limits ──
QUEUE_TIMEOUT_SECONDS=30
LLM_SEMAPHORE_QWEN=30
LLM_SEMAPHORE_EMBEDDING=50
RAG_SEMAPHORE=40

# ── CRAG Confidence Gating (disabled by default, enable after tuning) ──
CRAG_ENABLED=false
CRAG_HIGH_CONFIDENCE=0.05
CRAG_LOW_CONFIDENCE=0.01
CRAG_AMBIGUOUS_THRESHOLD=0.03

# ── Post-Generation Reflection (disabled by default) ──
REFLECTION_ENABLED=false

# Tool Calling Configuration
TOOL_CALLING_ENABLED=true
