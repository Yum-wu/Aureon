FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends nginx curl && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt .
RUN pip install -r requirements.txt
COPY backend/ .
RUN mkdir -p /app/data/vectors
# frontend-builder stage not available in single-stage test build
# Copy local dist if it exists, otherwise skip gracefully
COPY ./dist /usr/share/nginx/html 2>/dev/null || true
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["sh", "-c", "echo 'Container starting...' && sed -i 's/listen 80;/listen 8080;/' /etc/nginx/conf.d/default.conf && nginx && echo 'nginx started' && exec uvicorn app.main:app --host 127.0.0.1 --port 8000"]
